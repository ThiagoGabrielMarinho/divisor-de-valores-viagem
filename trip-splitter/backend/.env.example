# Copie este arquivo para .env e preencha com a connection string do seu Postgres.
#
# Local (ex.: docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/trip_splitter
#
# Render: em Dashboard > seu Postgres > Connect, copie a "Internal Database URL"
# (se o Web Service estiver na mesma região) e cole aqui/nas Environment
# Variables do Web Service. Não é preciso colar no .env local se você só usa
# isso via variáveis de ambiente configuradas direto no Render.
DATABASE_URL=
